{
  "name": "team-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k 'tsx watch server/src/index.ts' 'npm run dev -w web'",
    "build": "npm run build -w server && npm run build -w web",
    "start": "node server/dist/index.js",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "playwright test",
    "backup": "tsx server/src/cli.ts backup",
    "restore": "tsx server/src/cli.ts restore",
    "sync": "tsx server/src/cli.ts sync",
    "test-link": "tsx server/src/cli.ts test-link",
    "hash-password": "tsx server/src/cli.ts hash-password"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "lucide-react": "^1.77.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
